############################################
# 🧠 STM32CubeMX (generated code)
############################################


# Keep ONLY user entry points
!**/Core/Src/main.c
!**/Core/Inc/main.h

# Keep CubeMX config files
!**/*.ioc
!**/.mxproject

############################################
# 🛠 STM32CubeIDE / Eclipse
############################################

# Build outputs anywhere
**/Debug/
**/Release/
**/build/
**/*.elf
**/*.bin
**/*.hex
**/*.map
**/*.list

# Eclipse / CubeIDE metadata
.project
.cproject
.settings/
.metadata/
*.launch

############################################
# 🧾 Compilation artifacts
############################################

**/*.o
**/*.d
**/*.a
**/*.su
**/*.idb
**/*.pdb

############################################
# 🤖 STM32 AI (X-CUBE-AI / STM32Cube.AI / AI Studio)
############################################

# Generated AI application code
**/X-CUBE-AI/App/**
**/X-CUBE-AI/Target/**
**/X-CUBE-AI/Network/**

# AI intermediate models & exports
**/*.onnx
**/*.tflite
**/*.h5
**/*.pb

# AI logs & configs
**/*.json
**/*.log

# AI Studio workspace
**/.stm32ai/


############################################
# 🧪 Python / ML tooling
############################################

venv/
.env/
**/__pycache__/
**/*.pyc
.ipynb_checkpoints/

